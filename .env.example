# Qoneqt AI Content Studio Environment Configuration
# Copy this file to .env and configure your keys

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional Voice / Image API Keys (leave empty to use high-quality built-in engines)
VOICE_API_KEY=
IMAGE_API_KEY=

# Database configuration
DATABASE_URL=sqlite:///./qoneqt.db

# Feature flags
VOICE_ENABLED=true
IMAGE_GENERATION_ENABLED=true

# Demo Mode: Set to true for offline deterministic demo generation without API calls
DEMO_MODE=false

# Server configuration
HOST=0.0.0.0
PORT=8000
